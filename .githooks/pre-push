#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
python3 scripts/check_publication.py
if command -v gitleaks >/dev/null 2>&1; then
    scanner=gitleaks
elif [ -x "$HOME/.local/bin/gitleaks" ]; then
    scanner="$HOME/.local/bin/gitleaks"
else
    echo 'Install Gitleaks before pushing; see SECURITY.md.' >&2
    exit 1
fi
# Inspect every commit reachable from each ref being pushed, including tags.
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    "$scanner" git --log-opts="$local_sha" --config .gitleaks.toml --redact --no-banner --ignore-gitleaks-allow .
done
