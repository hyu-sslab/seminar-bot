DISCORD_TOKEN=replace-with-your-bot-token
# Optional development server. SEMINAR_GUILD_ID takes priority when set.
DISCORD_GUILD_ID=
DATA_DIR=./data
MAX_FILE_MB=20
DOCUMENT_PARSER_CPUS=1.0
LOG_LEVEL=INFO

# Website submission requires this integration. An empty API token disables submission.
# Never commit real credentials or actual deployment IDs here.
SEMINAR_API_TOKEN=
# Single active seminar server for commands, rotation, reminders and website.
SEMINAR_GUILD_ID=
SEMINAR_PAGE_URL=
SEMINAR_API_TRANSPORT=access
SEMINAR_RELAY_TOKEN=
SEMINAR_RELAY_URL=
SEMINAR_CONNECT_TOKEN=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_TUNNEL_TOKEN=
