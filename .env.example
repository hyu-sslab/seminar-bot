DISCORD_TOKEN=replace-with-your-bot-token
# Development server: commands register immediately here. Empty = global commands.
DISCORD_GUILD_ID=
DATA_DIR=./data
MAX_FILE_MB=20
LOG_LEVEL=INFO

# Optional website integration. Leave SEMINAR_API_TOKEN empty to disable it.
# Never commit real credentials or actual deployment IDs here.
SEMINAR_API_TOKEN=
SEMINAR_GUILD_ID=
SEMINAR_PAGE_URL=
SEMINAR_API_TRANSPORT=access
SEMINAR_RELAY_TOKEN=
SEMINAR_RELAY_URL=
SEMINAR_CONNECT_TOKEN=
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_TUNNEL_TOKEN=
